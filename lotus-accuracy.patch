+
+
+def _accuracy_for_sample(
+    proxy_scores: np.ndarray,
+    oracle_labels: np.ndarray,
+    correction_factors: np.ndarray,
+    pos_threshold: float,
+    neg_threshold: float,
+    candidate_delta: float,
+) -> tuple[float, float]:
+    auto_positive = proxy_scores >= pos_threshold
+    auto_negative = (~auto_positive) & (proxy_scores <= neg_threshold)
+    errors = (auto_positive & (oracle_labels == 0)) | (auto_negative & (oracle_labels == 1))
+    corrected_errors = correction_factors * errors.astype(float)
+    estimated_error = float(np.mean(corrected_errors))
+    std_error = float(np.std(corrected_errors))
+    margin = (std_error / math.sqrt(len(corrected_errors))) * math.sqrt(2 * math.log(1 / candidate_delta))
+    upper_error = min(1.0, estimated_error + margin)
+    return 1.0 - estimated_error, 1.0 - upper_error
+
+
+def learn_accuracy_thresholds(
+    sample_proxy_scores: Sequence[float],
+    sample_oracle_labels: Sequence[int],
+    sample_correction_factors: Sequence[float],
+    all_proxy_scores: Sequence[float],
+    accuracy_target: float,
+    failure_probability: float,
+) -> tuple[float, float, float, float]:
+    """Jointly select thresholds with Lotus-style one-sided error bounds."""
+    sample_scores = np.asarray(sample_proxy_scores, dtype=float)
+    oracle_labels = np.asarray(sample_oracle_labels, dtype=int)
+    correction_factors = np.asarray(sample_correction_factors, dtype=float)
+    full_scores = np.asarray(all_proxy_scores, dtype=float)
+    if not len(sample_scores):
+        raise ValueError("Cannot learn accuracy thresholds from an empty calibration sample")
+
+    below_all = float(np.nextafter(min(0.0, float(np.min(full_scores))), -np.inf))
+    above_all = float(np.nextafter(max(1.0, float(np.max(full_scores))), np.inf))
+    candidates = sorted({below_all, above_all, *full_scores.tolist()})
+    pairs = [(neg, pos) for neg in candidates for pos in candidates if neg <= pos]
+    candidate_delta = failure_probability / len(pairs)
+
+    best: tuple[tuple[int, float, float, float], tuple[float, float, float, float]] | None = None
+    for neg_threshold, pos_threshold in pairs:
+        estimated_accuracy, accuracy_lower_bound = _accuracy_for_sample(
+            sample_scores,
+            oracle_labels,
+            correction_factors,
+            pos_threshold,
+            neg_threshold,
+            candidate_delta,
+        )
+        if accuracy_lower_bound < accuracy_target:
+            continue
+
+        oracle_calls = int(np.sum((full_scores < pos_threshold) & (full_scores > neg_threshold)))
+        key = (oracle_calls, -accuracy_lower_bound, pos_threshold, -neg_threshold)
+        value = (pos_threshold, neg_threshold, estimated_accuracy, accuracy_lower_bound)
+        if best is None or key < best[0]:
+            best = (key, value)
+
+    if best is None:
+        raise ValueError("No threshold pair satisfies the requested probabilistic accuracy target")
+    return best[1]
