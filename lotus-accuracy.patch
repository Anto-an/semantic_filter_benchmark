+def resolve_filter_positive_probability(
+    true_logprob: float | None,
+    false_logprob: float | None,
+    predicted_positive: bool,
+) -> float:
+    """Resolve a filter score using the same fallback as Lotus cascades.
+
+    Lotus normalizes the True/False alternatives when both are available. If
+    either alternative is unavailable, the emitted binary label is used as a
+    deterministic score (1 for True, 0 for False).
+    """
+    if true_logprob is not None and false_logprob is not None:
+        true_value = float(true_logprob)
+        false_value = float(false_logprob)
+        if math.isfinite(true_value) and math.isfinite(false_value):
+            return float(math.exp(true_value - np.logaddexp(true_value, false_value)))
+    return float(bool(predicted_positive))
+
